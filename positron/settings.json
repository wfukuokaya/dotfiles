  "security.workspace.trust.untrustedFiles": "open",
  "update.mode": "manual",
  "files.associations": {
    "renv.lock": "json"
  },
  "positron.assistant.enable": true,
  "positron.assistant.followups.enable": true,
  "editor.dropIntoEditor.preferences": [],
  "editor.formatOnPaste": true,
  "workbench.settings.applyToAllProfiles": [
    "editor.fontFamily",
    "quarto.cells.background.darkDefault",
    "quarto.visualEditor.defaultListSpacing"
  ],
  "console.fontFamily": "'UDEV Gothic 35NFLG', Menlo, Monaco, 'Courier New', monospace",
  "editor.fontFamily": "'UDEV Gothic 35NFLG', Monaco, 'Courier New', monospace, 'Cascadia Code', 'Fira Code'",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.selectedModel": "default",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "git.openAfterClone": "alwaysNewWindow",
  "claude.mcpServers": {
    "zotero": {
      "command": "npx",
      "args": [
        "-y",
        "@grantcarthew/zotero-mcp"
      ]
    }
  },
  "scm.inputFontFamily": "'UDEV Gothic 35NFLG'",
  "debug.console.fontFamily": "'UDEV Gothic 35NFLG'",
