  "markdown.preview.lineHeight": 1,
  "debug.console.fontSize": 15,
  "editor.fontSize": 15,
  "terminal.integrated.fontSize": 14.5,
  "editor.lineHeight": 1.3,
  "editor.suggestLineHeight": 25,
